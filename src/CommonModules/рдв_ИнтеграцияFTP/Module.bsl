#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ПолучитьФайлыСFTPСервера(ПараметрыСоединения, Соединение, Сообщение, ОтветСервиса, ДополнительныеПараметры)
	
	Успешно = Истина;
	ТекстОшибки = "";
	МассивFTPФайлов = Новый Массив;
	
	ДополнительныеНастройки = ПараметрыСоединения.ДополнительныеНастройки;
	
	ФайлыДляЧтения = ДополнительныеНастройки.ФайлыДляЧтения;
	
	Для Каждого СтрокаДляЧтения Из ФайлыДляЧтения Цикл
		ИмяКаталогаПоиска = СтрокаДляЧтения;
		
		Попытка
			НайденныеФайлы = Соединение.НайтиФайлы(ИмяКаталогаПоиска, "*.*");
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = "Неверно указан путь запрашиваемого файла,
			|подробное представление ошибки:
			|" + ТекстОшибки;
			
			Успешно = Ложь;
			Прервать;
		КонецПопытки;
		
		ИмяВидаСообщения = СтрЗаменить(СтрокаДляЧтения, "/", "");
		Для Каждого FTPФайл Из НайденныеФайлы Цикл
			Структура = Новый Структура("FTPФайл, АдресМетода", FTPФайл, ИмяВидаСообщения);
			МассивFTPФайлов.Добавить(Структура);
		КонецЦикла;
	КонецЦикла;
	
	ОтветСервиса = Новый Структура;
	ОтветСервиса.Вставить("ТекстОшибки", ТекстОшибки);
	ОтветСервиса.Вставить("Успешно", Успешно);
	ОтветСервиса.Вставить("Ответ", "");
	ОтветСервиса.Вставить("ДополнительныеНаборы", Неопределено);
	ОтветСервиса.Вставить("Статус", ?(ОтветСервиса.Успешно, "SUCCESS", "FAILURE"));
	
	Возврат МассивFTPФайлов;
	
КонецФункции

Функция ФорматОбменаПоРасширению(РасширениеФайла)
	
	ФорматОбмена = Неопределено;
	
	Попытка
		ФорматОбмена = Перечисления.рдв_ФорматыОбмена[РасширениеФайла];
	Исключение
        ВызватьИсключение "Не удалось определить формат сообщения по расширению";
	КонецПопытки;
	
	Возврат ФорматОбмена;
	
КонецФункции

Процедура УдалитьВременныйФайл(Знач Путь) Экспорт
	
	Попытка
		УдалитьФайлы(Путь);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Удаление файла'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
