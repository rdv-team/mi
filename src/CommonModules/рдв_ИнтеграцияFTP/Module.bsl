
#Область ПрограммныйИнтерфейс

// Возвращает описание динамических настроек интеграции.
// Возвращаемое значение:
//  Структура - Описание параметров интеграции, содержащее:
//   * Таймаут - Число
//
Функция ДинамическиеНастройкиИтеграцииОписание() Экспорт
	
	ПараметрыИтеграции = Новый Структура;
	
	Модуль = ОбщегоНазначения.ОбщийМодуль("рдв_Интеграция");
	
	ЗначениеПоУмолчанию = 30;
	Модуль.ИнтеграцияДобавитьОписаниеПараметра(ПараметрыИтеграции, "Таймаут", "Таймаут"
										, ОбщегоНазначения.ОписаниеТипаЧисло(10,0), ЗначениеПоУмолчанию);
										
	ЗначениеПоУмолчанию = Истина;
	Модуль.ИнтеграцияДобавитьОписаниеПараметра(ПараметрыИтеграции, "УдалятьПрочитанныеФайлы", "Удалять прочитанные файлы"
										, Новый ОписаниеТипов("Булево"), ЗначениеПоУмолчанию);
	
	ЗначениеПоУмолчанию = Истина;
	Модуль.ИнтеграцияДобавитьОписаниеПараметра(ПараметрыИтеграции, "ПеремещатьВОтдельныйКаталог", "Перемещать прочитанные файлы в отдельный файл"
										, Новый ОписаниеТипов("Булево"), ЗначениеПоУмолчанию);
	
	ЗначениеПоУмолчанию = Новый СписокЗначений;
	Модуль.ИнтеграцияДобавитьОписаниеПараметра(ПараметрыИтеграции, "ФайлыДляЧтения", "Каталог чтения данных"
										, Новый ОписаниеТипов("СписокЗначений"), ЗначениеПоУмолчанию);
	
	Возврат ПараметрыИтеграции;
	
КонецФункции

// Устанавливает соединение с FTP-сервером.
// Параметры:
//  ПараметрыСоединения - Структура - Параметры соединения:
//   * Адрес - Строка - Адрес сервера
//   * Порт - Число - Порт сервера (по умолчанию 21)
//   * Пользователь - Строка - Имя пользователя
//   * Пароль - Строка - Пароль пользователя
//   * ЗащищенноеСоединение - Булево
//  ДополнительныеПараметры - Структура - Дополнительные параметры соединения
// Возвращаемое значение:
//  FTPСоединение - Объект соединения с сервером
//
Функция СоединениеОткрыть(ПараметрыСоединения, ДополнительныеПараметры) Экспорт
	

	ЗащищенноеСоединение = Неопределено;
	Если ПараметрыСоединения.ЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	
	Порт = ПараметрыСоединения.Порт;
	Если Не ЗначениеЗаполнено(Порт) Тогда
		Порт = 21;
	КонецЕсли;
	
	Таймаут = ПараметрыСоединения.ДополнительныеНастройки.Таймаут;
	Если Таймаут = 0 Тогда
		Таймаут = 30;
	КонецЕсли;

	Соединение = Новый FTPСоединение(
		ПараметрыСоединения.Адрес,
		Порт,
		ПараметрыСоединения.Пользователь,
		ПараметрыСоединения.Пароль,,, 
		Таймаут,
		ЗащищенноеСоединение
	);
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыСоединения", ПараметрыСоединения);
	КонецЕсли;
	
	Возврат Соединение;
			
КонецФункции

// Проверяет доступность сервиса.
// Параметры:
//  ПараметрыСоединения - Структура - Параметры соединения:
//   * Адрес - Строка - Адрес сервера
//   * Порт - Число - Порт сервера (по умолчанию 21)
//   * Пользователь - Строка - Имя пользователя
//   * Пароль - Строка - Пароль пользователя
//   * ЗащищенноеСоединение - Булево
//  ДополнительныеПараметры - Структура - Дополнительные параметры соединения
// Возвращаемое значение:
//  Булево -
//
Функция ИнтеграцияДоступна(ПараметрыСоединения, ДополнительныеПараметры) Экспорт
	
	Доступна = Истина;
	
	Попытка
		Соединение = СоединениеОткрыть(ПараметрыСоединения, ДополнительныеПараметры);
		СоединениеЗакрыть(Соединение);
	Исключение
		Доступна = Ложь;
	КонецПопытки;
	
	Возврат Доступна;
	
КонецФункции

// Создает файл на FTP-сервере.
// Параметры:
//  ПараметрыСоединения - Структура - Параметры соединения
//  Соединение - FTPСоединение - Объект соединения
//  Сообщение - Структура - Данные сообщения:
//   * ТекстСообщения - Строка - Текст сообщения
//   * ИдентификаторСообщения - Строка - Идентификатор сообщения
//   * ИдентификаторСобытия - Строка - Идентификатор события
//  РезультатОтправки - Структура -  - Результат отправки:
//   * Успешно - Булево - Признак успешной отправки
//   * Статус - Строка - Статус отправки ("SUCCESS"/"FAILURE")
//   * Ответ - Строка - Текст ответа
//   * ДополнительныеНаборы - Структура - Дополнительные данные
//  ДополнительныеПараметры - Структура - см.ДинамическиеНастройкиИтеграцииОписание
//
Процедура ОтправитьСообщение(ПараметрыСоединения, Соединение, Сообщение, РезультатОтправки, ДополнительныеПараметры) Экспорт
	
	Если Сообщение.Свойство("ФорматОбмена") И ЗначениеЗаполнено(Сообщение.ФорматОбмена) Тогда
		ФорматОбмена = Сообщение.ФорматОбмена;
	Иначе
		ФорматОбмена = Перечисления.рдв_ФорматыОбмена.json;
	КонецЕсли;
	
	РасширениеФайла = НРег(Строка(ФорматОбмена));
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	Если ФорматОбмена = Перечисления.рдв_ФорматыОбмена.json Тогда
		Данные = рдв_ЧтениеJSON.ПрочитатьТекстСообщения(Сообщение.ТекстСообщения);
		
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(ИмяВременногоФайла);
		ЗаписатьJSON(Запись, Данные, Новый НастройкиСериализацииJSON);
		Запись.Закрыть();
	Иначе
		ЗначениеВФайл(ИмяВременногоФайла, Сообщение.ТекстСообщения);
	КонецЕсли;
	
	Миллисекунды = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекущаяДата = ТекущаяДата();
	ПредставлениеДаты = Формат(ТекущаяДата, "ДФ=yyyy_MM_dd_HH_mm_ss") + "_" + Прав("000" + Строка(Миллисекунды), 3);
	
	ИмяФайлаНаFTP = Сообщение.АдресМетода + "_" +ПредставлениеДаты+ "." + РасширениеФайла;

	Если ПараметрыСоединения.ДополнительныеНастройки.Свойство("ФайлыДляЧтения") И 
		ЗначениеЗаполнено(ПараметрыСоединения.ДополнительныеНастройки.ФайлыДляЧтения) Тогда
		
		ИмяФайлаНаFTP = ""+ПараметрыСоединения.ДополнительныеНастройки.ФайлыДляЧтения+"/"+ИмяФайлаНаFTP;
	КонецЕсли;
	
	Успешно = Ложь;
	ТекстОшибки = "";
	
	Попытка
		Соединение.Записать(ИмяВременногоФайла, ИмяФайлаНаFTP);
		Успешно = Истина
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	УдалитьВременныйФайл(ИмяВременногоФайла);
	
	РезультатОтправки.Успешно = Успешно;
	РезультатОтправки.Статус = ?(Успешно, "SUCCESS", "FAILURE");
	
	Если РезультатОтправки.Успешно Тогда
		РезультатОтправки.Ответ = "Файл создан";
	Иначе
		РезультатОтправки.ТекстОшибки = ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

// Читает файлы на FTP-сервере.
// Параметры:
//  ПараметрыСоединения - Структура - Параметры соединения
//  Соединение - FTPСоединение - Объект соединения
//  Сообщение - Структура - Структура для заполнения данными сообщения.
//  							Обязательна к заполнению.
//  							Эти данные будут сохранены для последующей обработки.
//   * ВидСообщения- Строка - представление вида сообщения в системе
//   * ТекстСообщения - Строка - входящее сообщение
//   * ИдентификаторСообщения - УИД сообщения
//   * ИдентификаторСобытия - УИД события
//  ОтветСервиса - Структура - Структура для заполнения результатом получения
//  							Обязательна к заполнению.
//  							Эти данные будут сохранены для последующей обработки.
//   					* ТекстОшибки- Строка - представление вида сообщения в системе
//   					* Успешно - Булево - признак факта получения сообщения
//   					* Ответ - УИД сообщения
//   					* ДополнительныеНаборы - Структура - коллекции для сохранения в логах (заголовки, параметрыURI и т.д.)
//   					* Статус - Строка - представление статуса SUCCES, FAILER и т.д.
//  ДополнительныеПараметры - Структура - см.ДинамическиеНастройкиИтеграцииОписание
// Возвращаемое значение:
//  Булево - Признак успешного получения сообщения
//
Функция ПолучитьСообщение(ПараметрыСоединения, Соединение, Сообщение, ОтветСервиса, ДополнительныеПараметры) Экспорт
	
	ДополнительныеНастройки = ПараметрыСоединения.ДополнительныеНастройки;
	
	Если Не ДополнительныеНастройки.Свойство("МассивFTPФайлов") Тогда
		МассивFTPФайлов = ПолучитьФайлыСFTPСервера(ПараметрыСоединения, Соединение, Сообщение, ОтветСервиса, ДополнительныеПараметры);
		ДополнительныеНастройки.Вставить("МассивFTPФайлов", МассивFTPФайлов);
		
		Если ОтветСервиса.Свойство("Успешно") И Не ОтветСервиса.Успешно Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеНастройки.МассивFTPФайлов.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УдалятьПрочитанныеФайлы = ДополнительныеНастройки.УдалятьПрочитанныеФайлы;
	ПеремещатьВОтдельныйКаталог = ДополнительныеНастройки.ПеремещатьВОтдельныйКаталог;

	Успешно = Истина;
	ТекстОшибки = "";
	
	СтруктураФайла = ДополнительныеНастройки.МассивFTPФайлов[0];
	FTPФайл = СтруктураФайла.FTPФайл;
	
	РасширениеФайла = СтрЗаменить(FTPФайл.Расширение, ".", "");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	ТекстСообщения = "";
	Попытка
		ФорматОбмена = ФорматОбменаПоРасширению(РасширениеФайла);
		Сообщение.Вставить("ФорматОбмена", ФорматОбмена);
		
		Соединение.Получить(FTPФайл.ПолноеИмя, ИмяВременногоФайла);
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяВременногоФайла);
		ТекстСообщения = ТекстовыйДокумент.ПолучитьТекст();
		
		Если УдалятьПрочитанныеФайлы Тогда
			Соединение.Удалить(FTPФайл.ПолноеИмя);
		ИначеЕсли ПеремещатьВОтдельныйКаталог Тогда
			КаталогПрочитанных = FTPФайл.Путь + "READ/";
			Если Соединение.НайтиФайлы(КаталогПрочитанных).Количество() = 0 Тогда
				Соединение.СоздатьКаталог(КаталогПрочитанных);
			КонецЕсли;
			
			НовыйПуть = СтрЗаменить(FTPФайл.ПолноеИмя, FTPФайл.Путь, КаталогПрочитанных);
			Соединение.Переместить(FTPФайл.ПолноеИмя, НовыйПуть);
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = "Не удалось получить содержание,
		|подробное представление ошибки:
		|" + ТекстОшибки;
			
		Успешно = Ложь;
	КонецПопытки;
	
	Сообщение.АдресМетода = СтруктураФайла.АдресМетода;
	Сообщение.ВидСообщения = СтруктураФайла.АдресМетода;
	Сообщение.ТекстСообщения = ТекстСообщения;
	Сообщение.ИдентификаторСобытия = Строка(Новый УникальныйИдентификатор());
	Сообщение.ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор());
		
	ДополнительныеНастройки.МассивFTPФайлов.Удалить(0);
	
	ОтветСервиса = Новый Структура;
	ОтветСервиса.Вставить("ТекстОшибки", ТекстОшибки);
	ОтветСервиса.Вставить("Успешно", Истина);
	ОтветСервиса.Вставить("Ответ", "");
	ОтветСервиса.Вставить("ДополнительныеНаборы", Неопределено);
	ОтветСервиса.Вставить("Статус", ?(ОтветСервиса.Успешно, "SUCCESS", "FAILURE"));
	
	Если Не Успешно Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

